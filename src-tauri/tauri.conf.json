{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YapFlow",
  "version": "0.2.8",
  "identifier": "app.yapflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/check-macos-signing.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "YapFlow",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#050505"
      },
      {
        "label": "notch",
        "title": "YapFlow Notch",
        "url": "index.html",
        "width": 300,
        "height": 37,
        "x": 540,
        "y": 0,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCQzA5QzY2NjY3QTVBMjMKUldRalducG1acHpBQzZwakxaVzRpNHk0Vm1BT0FIcWw1WTc4WU5GVy9mUlpFejlqdmdDQThyRmoK",
      "endpoints": [
        "https://yapflow-production.up.railway.app/api/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
